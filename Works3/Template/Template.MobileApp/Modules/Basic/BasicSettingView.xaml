<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:behaviors="clr-namespace:Template.MobileApp.Behaviors"
             xmlns:controls="clr-namespace:Template.MobileApp.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Basic"
             x:Class="Template.MobileApp.Modules.Basic.BasicSettingView"
             x:DataType="{x:Type module:BasicSettingViewModel}"
             s:BindingContextResolver.Type="{x:Type module:BasicSettingViewModel}"
             shell:ShellProperty.Title="Setting"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <!-- ReSharper disable Xaml.RedundantResource -->
    <ContentView.Resources>
        <ResourceDictionary>

            <Style x:Key="RootScroll"
                   TargetType="ScrollView">
                <Setter Property="BackgroundColor" Value="{StaticResource GrayLighten5}" />
            </Style>

            <Style x:Key="PageStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Padding" Value="12" />
                <Setter Property="Spacing" Value="12" />
            </Style>

            <Style x:Key="FieldGroupStack"
                   TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="6" />
            </Style>

            <Style x:Key="FieldCaptionLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource SecondaryTextColor}" />
            </Style>

            <Style x:Key="FieldBorder"
                   TargetType="Border">
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource GrayLighten1}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            </Style>

            <Style x:Key="SettingRowGrid"
                   TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="8" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>

            <Style x:Key="SettingNameLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
            </Style>

            <Style x:Key="SettingValueLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="End" />
                <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
            </Style>

            <Style x:Key="SummaryLabel"
                   TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource GrayDarken3}" />
                <Setter Property="LineHeight" Value="1.4" />
            </Style>

            <Style x:Key="RowButton"
                   TargetType="Button">
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="{StaticResource BlueDefault}" />
                                    <Setter Property="BorderColor" Value="{StaticResource GrayLighten1}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="{StaticResource GrayLighten1}" />
                                    <Setter Property="BorderColor" Value="{StaticResource GrayLighten3}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>
    <!-- ReSharper restore Xaml.RedundantResource -->

    <ScrollView Style="{StaticResource RootScroll}">
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp"
                               Icon="{x:Static fonts:MaterialIcons.Person}"
                               Title="Account">
                <VerticalStackLayout Style="{StaticResource FieldGroupStack}">
                    <Label Style="{StaticResource FieldCaptionLabel}"
                           Text="User name (Entry)" />
                    <Border Style="{StaticResource FieldBorder}">
                        <Entry behaviors:Focus.FocusedStroke="{StaticResource BlueDefault}"
                               behaviors:Focus.FocusedThickness="2.5"
                               Text="{Binding UserName}"
                               ToolTipProperties.Text="表示に使う名前を入力します" />
                    </Border>

                    <Label Style="{StaticResource FieldCaptionLabel}"
                           Text="Search (SearchBar)" />
                    <SearchBar Text="{Binding SearchText}"
                               Placeholder="設定を検索" ReturnType="Search"
                               SearchCommand="{Binding SearchCommand}"
                               SearchIconColor="{StaticResource BlueDefault}"
                               ToolTipProperties.Text="検索ボタンで確定します" />
                    <Label Style="{StaticResource FieldCaptionLabel}"
                           behaviors:AnimationOption.FadeInTrigger="{Binding LastSearch}"
                           IsVisible="{Binding LastSearch, Converter={StaticResource NotEmptyConverter}}"
                           Text="{Binding LastSearch, StringFormat='検索実行: {0}'}" />
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp" behaviors:AnimationOption.EnterDelay="60"
                               Icon="{x:Static fonts:MaterialIcons.Tune}"
                               Title="Display &amp; Sound">
                <VerticalStackLayout Style="{StaticResource FieldGroupStack}">
                    <Grid Style="{StaticResource SettingRowGrid}"
                          ColumnDefinitions="*,Auto,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource SettingNameLabel}"
                               Text="キャッシュ上限 (Stepper)" />
                        <Label Grid.Column="1"
                               Style="{StaticResource SettingValueLabel}"
                               Text="{Binding CacheSize, StringFormat='{0:F0} GB'}" />
                        <Stepper Grid.Column="2"
                                 Value="{Binding CacheSize}"
                                 Minimum="1" Maximum="8"
                                 Increment="1" ToolTipProperties.Text="ローカルキャッシュの上限サイズ" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRowGrid}"
                          ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource SettingNameLabel}"
                               Text="音量 (Slider)" />
                        <Slider Grid.Column="1"
                                Value="{Binding Volume}"
                                Minimum="0" Maximum="100"
                                ToolTipProperties.Text="通知音の音量" />
                        <Label Grid.Column="2"
                               Style="{StaticResource SettingValueLabel}"
                               WidthRequest="40"
                               Text="{Binding Volume, StringFormat='{0:F0}'}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRowGrid}"
                          ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource SettingNameLabel}"
                               Text="通知 (Switch)" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding NotificationEnabled}"
                                OffColor="{StaticResource GrayLighten1}"
                                ToolTipProperties.Text="プッシュ通知の有効/無効" />
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp" behaviors:AnimationOption.EnterDelay="120"
                               Icon="{x:Static fonts:MaterialIcons.Event}"
                               Title="Backup Schedule">
                <VerticalStackLayout Style="{StaticResource FieldGroupStack}">
                    <Grid Style="{StaticResource SettingRowGrid}"
                          ColumnDefinitions="*,Auto,Auto,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource SettingNameLabel}"
                               Text="日付 (DatePicker)" />
                        <DatePicker Grid.Column="1"
                                    Date="{Binding BackupDate}"
                                    IsOpen="{Binding BackupDateOpen}"
                                    ToolTipProperties.Text="次回バックアップ日" />
                        <Button Grid.Column="2"
                                Style="{StaticResource RowButton}"
                                Command="{Binding OpenBackupDateCommand}"
                                Text="開く" />
                        <Button Grid.Column="3"
                                Style="{StaticResource RowButton}"
                                Command="{Binding ClearBackupDateCommand}"
                                Text="クリア" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRowGrid}"
                          ColumnDefinitions="*,Auto,Auto,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource SettingNameLabel}"
                               Text="時刻 (TimePicker)" />
                        <TimePicker Grid.Column="1"
                                    IsOpen="{Binding BackupTimeOpen}"
                                    Time="{Binding BackupTime}"
                                    ToolTipProperties.Text="次回バックアップ時刻" />
                        <Button Grid.Column="2"
                                Style="{StaticResource RowButton}"
                                Command="{Binding OpenBackupTimeCommand}"
                                Text="開く" />
                        <Button Grid.Column="3"
                                Style="{StaticResource RowButton}"
                                Command="{Binding ClearBackupTimeCommand}"
                                Text="クリア" />
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp" behaviors:AnimationOption.EnterDelay="180"
                               Icon="{x:Static fonts:MaterialIcons.Language}"
                               Title="Quality &amp; Language">
                <VerticalStackLayout Style="{StaticResource FieldGroupStack}">
                    <Label Style="{StaticResource FieldCaptionLabel}"
                           Text="画質 (RadioButton)" />
                    <HorizontalStackLayout RadioButtonGroup.GroupName="Quality"
                                           RadioButtonGroup.SelectedValue="{Binding Quality, Mode=TwoWay}"
                                           Spacing="8">
                        <RadioButton Value="low"
                                     Content="低" />
                        <RadioButton Value="middle"
                                     Content="中" />
                        <RadioButton Value="high"
                                     Content="高" />
                    </HorizontalStackLayout>

                    <Label Style="{StaticResource FieldCaptionLabel}"
                           Text="言語 (Picker)" />
                    <Grid Style="{StaticResource SettingRowGrid}"
                          ColumnDefinitions="*,Auto">
                        <Border Grid.Column="0"
                                Style="{StaticResource FieldBorder}">
                            <Picker ItemsSource="{Binding Languages}"
                                    IsOpen="{Binding LanguageOpen}"
                                    SelectedItem="{Binding Language}"
                                    ToolTipProperties.Text="表示言語を選択します" />
                        </Border>
                        <Button Grid.Column="1"
                                Style="{StaticResource RowButton}"
                                Command="{Binding OpenLanguageCommand}"
                                Text="開く" />
                    </Grid>
                </VerticalStackLayout>
            </controls:InfoCard>

            <controls:InfoCard behaviors:AnimationOption.EnterAnimation="FadeUp" behaviors:AnimationOption.EnterDelay="240"
                               Icon="{x:Static fonts:MaterialIcons.Fact_check}"
                               Title="Summary">
                <VerticalStackLayout Style="{StaticResource FieldGroupStack}">
                    <Label Style="{StaticResource SummaryLabel}"
                           Text="{Binding UserName, StringFormat='ユーザー: {0}'}" />
                    <Label Style="{StaticResource SummaryLabel}"
                           Text="{Binding CacheSize, StringFormat='キャッシュ: {0:F0} GB'}" />
                    <Label Style="{StaticResource SummaryLabel}"
                           Text="{Binding Volume, StringFormat='音量: {0:F0}'}" />
                    <Label Style="{StaticResource SummaryLabel}"
                           Text="{Binding BackupDate, StringFormat='バックアップ: {0:yyyy/MM/dd}', TargetNullValue='バックアップ: 未設定'}" />
                    <Label Style="{StaticResource SummaryLabel}"
                           Text="{Binding BackupTime, StringFormat='時刻: {0:hh\\:mm}', TargetNullValue='時刻: 未設定'}" />
                    <Label Style="{StaticResource SummaryLabel}"
                           Text="{Binding Quality, StringFormat='画質: {0}'}" />
                    <Label Style="{StaticResource SummaryLabel}"
                           Text="{Binding Language, StringFormat='言語: {0}'}" />
                </VerticalStackLayout>
            </controls:InfoCard>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
