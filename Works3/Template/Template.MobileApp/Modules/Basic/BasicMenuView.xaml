<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:shell="clr-namespace:Template.MobileApp.Shell"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:markup="clr-namespace:Template.MobileApp.Markup"
             xmlns:module="clr-namespace:Template.MobileApp.Modules.Basic"
             x:Class="Template.MobileApp.Modules.Basic.BasicMenuView"
             x:DataType="{x:Type module:BasicMenuViewModel}"
             s:BindingContextResolver.Type="{x:Type module:BasicMenuViewModel}"
             shell:ShellProperty.Title="Basic"
             shell:ShellProperty.Function1Text="Back"
             shell:ShellProperty.Function1Enabled="True">

    <Grid Style="{StaticResource MenuGrid}"
          RowDefinitions="*,*,*,*,*,*,*,*,*">
        <Button Grid.Row="0"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId BasicTypography}"
                Text="Typography"
                ImageSource="{markup:MenuIcon {x:Static fonts:MaterialIcons.Text_fields}}" />
        <Button Grid.Row="1"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId BasicStyle}"
                Text="Style"
                ImageSource="{markup:MenuIcon {x:Static fonts:MaterialIcons.Format_paint}}" />
        <Button Grid.Row="2"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId BasicFont}"
                Text="Font"
                ImageSource="{markup:MenuIcon {x:Static fonts:MaterialIcons.Font_download}}" />
        <Button Grid.Row="3"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId BasicConverter}"
                Text="Converter"
                ImageSource="{markup:MenuIcon {x:Static fonts:MaterialIcons.Swap_horiz}}" />
        <Button Grid.Row="4"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId BasicBehavior}"
                Text="Behavior"
                ImageSource="{markup:MenuIcon {x:Static fonts:MaterialIcons.Touch_app}}" />
        <Button Grid.Row="5"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId BasicLocale}"
                Text="Locale"
                ImageSource="{markup:MenuIcon {x:Static fonts:MaterialIcons.Translate}}" />
        <Button Grid.Row="6"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId BasicDialog}"
                Text="Dialog"
                ImageSource="{markup:MenuIcon {x:Static fonts:MaterialIcons.Forum}}" />
        <Button Grid.Row="7"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId BasicValidation}"
                Text="Validation"
                ImageSource="{markup:MenuIcon {x:Static fonts:MaterialIcons.Fact_check}}" />
        <Button Grid.Row="8"
                Style="{StaticResource MenuIconButton}"
                Command="{Binding ForwardCommand}"
                CommandParameter="{markup:ViewId BasicSetting}"
                Text="Setting"
                ImageSource="{markup:MenuIcon {x:Static fonts:MaterialIcons.Settings}}" />
    </Grid>

</ContentView>
