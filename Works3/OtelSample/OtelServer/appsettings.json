{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:4317",
        "Protocols": "Http2"
      }
    }
  },
  "TelemetryStore": {
    "DatabasePath": "App_Data/otel.db",
    "RetentionDays": 7,
    "MaxPointsPerMetricSeries": 500,
    "MaxLogsPerService": 2000,
    "MaxTraces": 500,
    "MaxSpansPerTrace": 200
  }
}
