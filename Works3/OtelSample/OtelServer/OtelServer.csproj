<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.1" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- OTLP (opentelemetry-proto v1.7.0) のメッセージ定義。サービス (gRPC) は生成しない -->
    <Protobuf Include="Protos\**\*.proto" ProtoRoot="Protos" GrpcServices="None" />
  </ItemGroup>

</Project>
